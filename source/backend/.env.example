# ---------------------------------------------------------------------------
# TrustWeave backend configuration
#
# Copy to .env and fill in only what you need. Every value below has a working
# default, so the system runs end to end with an empty file: SQLite for storage,
# an in-memory chain, a deterministic payment provider and a rule-based proposal
# extractor. Adding real credentials swaps each adapter for its live counterpart
# without any code change.
#
# NEVER commit a populated .env. It is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"
LOG_LEVEL="info"

# Comma-separated origins permitted by CORS. A wildcard is refused at startup
# when NODE_ENV=production.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW="1 minute"

# --- Database ---
# A file path, not a connection URL. The backend uses Node's built-in SQLite
# (node:sqlite, Node >= 22.5), so there is no database server to install.
DATABASE_FILE="./trustweave.db"

# --- Authentication ---
SESSION_TTL_MINUTES=480
CHALLENGE_TTL_SECONDS=120

# Password sign-in is a development convenience so a reviewer can open the app
# without generating a keypair. The server REFUSES TO START with this enabled
# when NODE_ENV=production; DID challenge/response is the supported path.
ALLOW_PASSWORD_LOGIN="true"

# --- AI provider (SERVER-ONLY SECRET) ---
# Leave LLM_PROVIDER=mock to use the deterministic extractor. It produces the
# same structured proposal shape as a live model, so the authorization pipeline
# is exercised identically either way.
LLM_PROVIDER="mock"            # "mock" | "anthropic"
LLM_API_KEY=""                 # SECRET — never expose to the frontend
LLM_MODEL="claude-sonnet-4-6"

# --- Razorpay (SERVER-ONLY SECRETS, TEST KEYS ONLY) ---
# RAZORPAY_ADAPTER=test uses a local provider that performs real HMAC signature
# verification and real idempotency, without a network call.
# The live adapter REFUSES any key not prefixed rzp_test_ unless you also set
# ALLOW_LIVE_KEYS=true, which you should not do for this project.
RAZORPAY_ADAPTER="test"        # "test" | "live"
RAZORPAY_KEY_ID=""             # rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=""         # SECRET
RAZORPAY_WEBHOOK_SECRET=""     # SECRET — required at startup when NODE_ENV=production

# --- Blockchain (SERVER-ONLY SECRET for the private key) ---
# The EVM adapter activates only when an RPC URL, a private key and all four
# registry addresses are present; otherwise the in-memory chain is used and every
# receipt is marked simulated:true so nothing pretends to be on a real chain.
BLOCKCHAIN_ADAPTER="memory"    # "memory" | "evm"
CHAIN_RPC_URL=""
CHAIN_PRIVATE_KEY=""           # SECRET — the backend's writer key, NOT the contract admin key
CHAIN_ID="11155111"

# Written for you by `npm run wire-backend` in the contracts package after a deploy.
IDENTITY_REGISTRY_ADDRESS=""
ASSET_REGISTRY_ADDRESS=""
AGENT_REGISTRY_ADDRESS=""
PROOF_REGISTRY_ADDRESS=""

# --- Seed ---
# Password applied to every demo identity created by `npm run db:seed`.
SEED_PASSWORD="TrustWeave!2026"
