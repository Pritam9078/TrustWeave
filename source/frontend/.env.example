# ---------------------------------------------------------------------------
# TrustWeave frontend configuration
#
# Everything in a Vite VITE_* variable is compiled into the browser bundle and is
# therefore PUBLIC. No secret may appear in this file. The frontend holds no API
# keys: it talks only to the TrustWeave backend, which owns every credential and
# performs every authorization check.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL="http://localhost:4000"
